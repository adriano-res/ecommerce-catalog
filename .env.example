# Application Port
PORT=8080

# Spring Profiles (local, prod)
SPRING_PROFILES_ACTIVE=local

# MongoDB Replica Set (rs0)
MONGODB_URI=mongodb://localhost:27017/catalog?replicaSet=rs0

# Redis Cache
REDIS_URL=redis://localhost:6379

# JWT Authentication (HMAC-SHA256, minimum 256 bits secret)
JWT_SECRET=dev-secret-key-must-be-at-least-256-bits-long-for-hmac-sha-256

# S3 / SeaweedFS Storage
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=ecommerce-catalog
S3_ACCESS_KEY=anyadmin
S3_SECRET_KEY=anyadmin
S3_REGION=us-east-1
